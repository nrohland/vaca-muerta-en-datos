# Names only. Meltano: extraction/.env.example. dbt: transform/.env.example.

BIGQUERY_PROJECT=<project-id>
BIGQUERY_LOCATION=US
BIGQUERY_DATASET=raw_cap4
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/meltano-raw-writer.json

# Hito 2 dbt (separate SA — do not reuse the Meltano key):
# DBT_BIGQUERY_PROJECT=<project-id>
# DBT_DATASET_RAW=raw_cap4_dev
# DBT_DATASET_STG=stg_cap4_dev
# DBT_DATASET_INT=int_cap4_dev
# DBT_DATASET_MARTS=marts_cap4_dev
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/vm-pulse-dbt.json
# GCP_SA_KEY_DBT=<full JSON of vm-pulse-dbt; Cursor/GH secret, not git>
